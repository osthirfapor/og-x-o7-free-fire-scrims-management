rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;

      match /teams/{teamId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /match_results/{resultId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
