rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{adminUid} {
      // An authenticated user may check their own admin record. Admin records
      // are provisioned out-of-band in Firebase Console and cannot be self-created.
      allow get: if request.auth != null && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /banned_teams/{banId} {
      // Public registration checks a known normalized team-name key.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'status', 'updatedAt'])
        && request.resource.data.registeredCount == resource.data.registeredCount + 1
        && resource.data.status == 'open'
        && request.resource.data.registeredCount <= resource.data.maxTeams
        && request.resource.data.status == (request.resource.data.registeredCount == resource.data.maxTeams ? 'closed' : 'open')
      );

      match /teams/{teamId} {
        allow read: if true;
        allow create: if isAdmin() || (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status == 'open'
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.registeredCount
            < get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.maxTeams
          && getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)).data.registeredCount
            == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.registeredCount + 1
          && request.resource.data.status == 'approved'
          && request.resource.data.tournamentId == tournamentId
          && request.resource.data.teamName is string
          && request.resource.data.teamName.size() > 0
          && request.resource.data.teamLogo is string
          && request.resource.data.teamLogo.size() > 0
          && request.resource.data.registrationId is string
          && request.resource.data.players is list
          && request.resource.data.players.size() >= 4
          && request.resource.data.players.size() <= 5
          && request.resource.data.playerNames is list
        );
        allow update, delete: if isAdmin();
      }
    }

    match /match_results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registration_logs/{logId} {
      allow read: if isAdmin();
      // One public audit entry per real registration; its fields must match the
      // already-created team, and clients cannot edit or remove it afterwards.
      allow create: if isAdmin() || (
        request.auth == null
        && request.resource.data.teamId is string
        && logId == request.resource.data.teamId
        && exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/teams/$(request.resource.data.teamId))
        && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/teams/$(request.resource.data.teamId)).data.registrationId == request.resource.data.registrationId
        && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/teams/$(request.resource.data.teamId)).data.teamName == request.resource.data.teamName
        && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/teams/$(request.resource.data.teamId)).data.leaderName == request.resource.data.leaderName
      );
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
